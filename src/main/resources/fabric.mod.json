{
	"schemaVersion": 1,
	"id": "stormlightmod",
	"version": "${version}",
	"name": "Stormlight mod",
	"description": "Adds The Stormlight Archive to Minecraft!",
	"authors": [
		"Me!"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/CadenTate/StormlightMod"
	},
	"license": "MIT",
	"icon": "assets/stormlightmod/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"ctnightfury.stormlightmod.StormlightMod"
		],
		"fabric-datagen": [
			"ctnightfury.stormlightmod.StormlightModDataGenerator"
		],
		"client": [
			"ctnightfury.stormlightmod.StormlightModClient"
		],
		"cardinal-components": [
			"ctnightfury.stormlightmod.component.ModComponents"
		]
	},
	"mixins": [
		"stormlightmod.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.16.7",
		"minecraft": "~1.21",
		"java": ">=21",
		"fabric-api": "*"
	},
	"suggests": {
		"another-mod": "*"
	},
	"custom": {
		"cardinal-components":[
			"stormlightmod:stormlight",
			"stormlightmod:gravitation"
		]
	}
}